{
  "name": "clinic-grower-internal-crm-backend",
  "version": "1.0.0",
  "description": "Backend for the Clinic Grower internal CRM, built on Express, TypeScript, and Node.",
  "homepage": "https://github.com/The-Growth-Group/clinic-grower-internal-crm-backend#readme",
  "bugs": {
    "url": "https://github.com/The-Growth-Group/clinic-grower-internal-crm-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Growth-Group/clinic-grower-internal-crm-backend.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "dev": "concurrently --raw \"npm run watch\" \"nodemon\"",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:restore:rehearse": "node scripts/rehearse-restore.mjs",
    "validate:scoro-import": "node scripts/validate-scoro-import.mjs",
    "qa:mvp": "node scripts/mission-control-mvp-qa.mjs",
    "setup:brevo-inbound": "node scripts/setup-brevo-inbound-webhook.mjs",
    "seed:staging-demo": "node scripts/seed-staging-demo.mjs",
    "credentials:rewrap": "node scripts/rewrap-provider-credentials.mjs",
    "security:scan": "node ../scripts/scan-secrets.mjs --include-build-output",
    "test": "npm run build && npm run test:smoke",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:smoke": "NODE_ENV=test node --test --test-force-exit --test-concurrency=1 scripts/backup-db-options.test.mjs dist/test/test-csv.js dist/test/test-export-validators.js dist/test/test-command-palette.js dist/test/test-internal-delivery-tasks.js dist/test/test-strategy-logs.js dist/test/test-sops.js dist/test/test-client-accounts.js dist/test/test-lead-hub.js dist/test/test-landing-page-lead-intake.js dist/test/test-observability.js dist/test/test-proposals-public.js dist/test/test-proposals.js dist/test/test-roles-management.js dist/test/test-scoro-import-templates.js",
    "test:client-accounts": "npm run build && node --test dist/test/test-client-accounts.js",
    "test:integration": "npm run build && node --test dist/test/test-internal-delivery-tasks.js dist/test/test-strategy-logs.js dist/test/test-sops.js dist/test/test-client-accounts.js dist/test/test-performance-os-chain.js",
    "test:whatsapp-ai": "npm run build && node --test dist/test/test-whatsapp-ai.js",
    "test:twilio-whatsapp": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc && node --test --experimental-test-isolation=none --test-concurrency=1 dist/test/test-twilio-whatsapp-provider.js dist/test/test-twilio-whatsapp-webhook.js",
    "test:proposals-public": "npm run build && node --test dist/test/test-proposals-public.js",
    "test:proposals": "npm run build && node --test dist/test/test-proposals.js",
    "test:clickup": "npm run build && node --test --experimental-test-isolation=none --test-concurrency=1 dist/test/test-clickup-mappings.js",
    "test:quickbooks": "npm run build && node --test --experimental-test-isolation=none --test-concurrency=1 dist/test/test-quickbooks-oauth.js",
    "test:landing-page-leads": "npm run build && node --test --test-force-exit --test-concurrency=1 dist/test/test-landing-page-lead-intake.js",
    "test:data-state": "npm run build && node --test --experimental-test-isolation=none --test-force-exit --test-concurrency=1 dist/test/test-data-state-safety.js",
    "test:security": "npm run build && node --test --experimental-test-isolation=none dist/test/test-secret-config.js && npm run security:scan",
    "qa:phase1": "node scripts/phase1-browser-qa.mjs"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "express-rate-limit": "^8.4.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jest": "^30.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "mysql2": "^3.22.2",
    "nodemon": "^3.1.14",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "stripe": "^22.1.1",
    "twilio": "^6.0.2",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.2.1"
  }
}
