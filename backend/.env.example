# Core
NODE_ENV=development
PORT=4000

# Public URLs / domain for the internal CRM.
# Do not reuse clinic-facing production URLs in this internal project.
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:4000/api/auth

# Database. This app uses discrete MySQL vars, not DATABASE_URL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=growth_group_internal_crm
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Local seeded Super Admin
# Matches backend/db.sql for fresh local database imports.
SUPER_ADMIN_EMAIL=admin@thegrowthgroup.com
SUPER_ADMIN_PASSWORD=MissionControl123!

# 2FA
OTP_EXPIRY_MINUTES=10

# Email
EMAIL_PROVIDER=brevo
# Single formatted sender used by the app.
EMAIL_FROM="The Growth Group Internal CRM <noreply@thegrowthgroup.local>"
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_INBOUND_DOMAIN=
EMAIL_INBOUND_PUBLIC_URL=
EMAIL_INBOUND_WEBHOOK_SECRET=
EMAIL_INBOUND_WORKSPACE_ID=clinic-001
EMAIL_INBOUND_WORKSPACE_MAP={"wordpresshealth@leapdigital.online":"clinic-001"}

# OpenAI
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/responses
OPENAI_DEFAULT_MODEL=gpt-5-mini
OPENAI_DEEP_AUDIT_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_INSIGHTS_ENABLED=false
OPENAI_INSIGHTS_MODEL=gpt-5-mini
OPENAI_CALL_INTELLIGENCE_ENABLED=false
OPENAI_CALL_INTELLIGENCE_MODEL=gpt-5-mini
OPENAI_CALL_TRANSCRIPTION_ENABLED=false
OPENAI_CALL_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TIMEOUT_MS=15000

# Twilio call tracking, recording download, WhatsApp sending, and webhook validation.
# For WhatsApp go-live, set WHATSAPP_PROVIDER=twilio and configure the exact
# public webhook URL in Twilio as:
#   https://your-api-domain.com/api/webhooks/whatsapp/inbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_SECRET=
TWILIO_WHATSAPP_SENDER=whatsapp:+447000000000
TWILIO_WHATSAPP_WEBHOOK_URL=https://your-api-domain.com/api/webhooks/whatsapp/inbound

# Provider/connector credential encryption. Store real values in the approved
# vault or hosting secret manager; do not commit them.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=v1
CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
CREDENTIAL_ENCRYPTION_LEGACY_JWT_SECRET=

# WhatsApp lead replies
# WHATSAPP_PROVIDER=log keeps local/dev sends internal and does not call a provider.
# Set WHATSAPP_PROVIDER=twilio for the current WhatsApp go-live path.
# Meta variables are retained for later but are not required when provider=twilio.
WHATSAPP_PROVIDER=log
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_WORKSPACE_ID=clinic-001
# Optional map from Twilio receiving WhatsApp number to workspace.
# Example: {"whatsapp:+447000000000":"clinic-001","+447000000000":"clinic-001"}
WHATSAPP_WEBHOOK_WORKSPACE_MAP=

# ClinicGrower -> Mission Control server-to-server events.
# ClinicGrower should POST missed-call recovery events to:
#   https://your-api-domain.com/api/webhooks/clinicgrower/missed-call-recovery
# using X-ClinicGrower-Timestamp and X-ClinicGrower-Signature headers.
CLINICGROWER_EVENT_SIGNING_SECRET=
CLINICGROWER_EVENT_TIMESTAMP_TOLERANCE_SECONDS=300

# E-signature requests
# ESIGN_PROVIDER=log records requests/evidence internally without calling an external provider.
ESIGN_PROVIDER=log
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# ClickUp delivery integration
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2
CLICKUP_APP_AUTH_URL=https://app.clickup.com/api

# QuickBooks finance integration
QUICKBOOKS_OAUTH_ENABLED=false
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_SCOPES=com.intuit.quickbooks.accounting
QUICKBOOKS_CUSTOMER_PAGE_SIZE=50

# Backups
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_KEY=
BACKUP_OFFSITE_DIR=
BACKUP_FILE_DIRS=
BACKUP_RESTORE_RTO_MINUTES=60
BACKUP_RESTORE_RPO_MINUTES=1440
RESTORE_REHEARSAL_DB_USER=
RESTORE_REHEARSAL_DB_PASSWORD=
BACKUP_KEEP_PLAINTEXT=false
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
TAR_BIN=tar

# Background jobs
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_JOBS_POLL_INTERVAL_MS=60000

# Observability and alert routing
OBSERVABILITY_SERVICE_NAME=mission-control-backend
OBSERVABILITY_ALERT_WEBHOOK_URL=
OBSERVABILITY_ALERT_WEBHOOK_TOKEN=
OBSERVABILITY_ALERT_TIMEOUT_MS=5000
OBSERVABILITY_TEST_ENABLED=false
OBSERVABILITY_TEST_TOKEN=

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_ALLOWED_DOMAINS=leapdigital.online
GOOGLE_OAUTH_AUTO_PROVISION_CLINIC_ID=clinic-001
GOOGLE_OAUTH_AUTO_PROVISION_ROLE=ADMIN
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v24
# Store a per-workspace Drive refresh token after an admin completes OAuth.
GOOGLE_DRIVE_DATABASE_OAUTH_ENABLED=false
GOOGLE_DRIVE_VALIDATION_ENABLED=true
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_SERVICE_ACCOUNT_SUBJECT=
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive
GOOGLE_CALENDAR_OAUTH_ENABLED=false
GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly
GOOGLE_CALENDAR_SYNC_WINDOW_DAYS=30
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# FACEBOOK_APP_ID and FACEBOOK_APP_SECRET are accepted fallbacks.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Provider placeholders currently represented by manual/staging-safe app flows.
# There are no runtime WhatsApp lead-intake env vars in code yet.

# Stripe. Leave blank unless Mission Control has its own test/internal Stripe setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLAN_STARTER_ID=
STRIPE_PLAN_PROFESSIONAL_ID=

# Staging demo seed. This is opt-in and must not use clinic-facing launch data.
# Required by npm run seed:staging-demo. Must be at least 12 characters.
DEMO_SEED_PASSWORD=
# Required seed SQL path. The legacy clinic seed is no longer a default.
DEMO_SEED_SQL=
# Leave false/blank except for deliberate local compatibility runs.
DEMO_SEED_ALLOW_LEGACY=false
# Set to REMOVE_MISSION_CONTROL_DEMO only when intentionally removing fictional demo data.
DEMO_SEED_REMOVE_CONFIRM=
