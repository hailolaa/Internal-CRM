{
  "name": "clinic-grower-internal-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "security:scan": "node ../scripts/scan-secrets.mjs --include-build-output",
    "security:public-env": "node scripts/scan-public-env.mjs --include-build-output",
    "test:security": "npm run security:public-env && npm run security:scan",
    "test": "vitest run",
    "test:e2e:smoke": "playwright test -c playwright.config.ts",
    "test:e2e:smoke:list": "playwright test -c playwright.config.ts --list",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serve": "^14.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
